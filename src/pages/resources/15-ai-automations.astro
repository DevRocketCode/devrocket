---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { aiAutomations, automationCategories } from '../../data/aiAutomations';

const categoryLabels = {
  Revenue: 'Capture demand',
  Customer: 'Serve and retain customers',
  Marketing: 'Turn expertise into attention',
  Operations: 'Remove back-office drag',
  Team: 'Scale knowledge and reliability',
};

const categoryIntros = {
  Revenue: 'Give sellers more time for conversations and make sure strong intent never waits in a queue.',
  Customer: 'Use AI to improve speed and coverage while preserving a thoughtful path to a person.',
  Marketing: 'Create more useful touchpoints from work your team has already done.',
  Operations: 'Convert document-heavy workflows into controlled, measurable systems.',
  Team: 'Make hard-won company context available at the moment someone needs it.',
};

const evidence = [
  {
    value: '60%',
    label: 'of the average seller’s time is spent away from selling',
    source: 'Salesforce research, 2026',
    href: 'https://www.salesforce.com/news/stat-library/all-stats/?q=spend%20selling',
  },
  {
    value: '14%',
    label: 'more support issues resolved per hour with AI assistance',
    source: 'NBER study of 5,000+ agents',
    href: 'https://www.nber.org/digest/20236/measuring-productivity-impact-generative-ai',
  },
  {
    value: '50 min',
    label: 'saved per user each week reading email in one field study',
    source: 'Microsoft WorkLab',
    href: 'https://www.microsoft.com/en-us/worklab/ai-data-drop-3-key-insights-from-real-world-research-on-ai-usage',
  },
];
---

<BaseLayout
  title="15 AI Automations That Save Your Team Time and Drive Revenue | DevRocket"
  description="Real-world AI automations for modern teams, with practical workflows, vetted tools, rollout guardrails, KPIs, and implementation resources."
>
  <div class="guide-controls" aria-label="Resource controls">
    <button type="button" data-print><i class="fa fa-print" aria-hidden="true"></i> Print / Save PDF</button>
  </div>

  <main class="automation-guide">
    <header class="guide-hero">
      <div class="guide-grid" aria-hidden="true"></div>
      <div class="hero-orbit hero-orbit--one" aria-hidden="true"></div>
      <div class="hero-orbit hero-orbit--two" aria-hidden="true"></div>
      <div class="guide-shell guide-hero__inner">
        <div class="guide-brand">
          <img src="/img/about/dev-rocket-white-on-black.svg" alt="DevRocket" />
          <span>Practical AI systems</span>
        </div>
        <p class="guide-kicker"><span></span> Free field guide · 2026 edition</p>
        <h1>15 AI Automations That Save Your Team Time and <em>Drive Revenue</em></h1>
        <p class="guide-subtitle">Real-world AI automations for modern teams</p>
        <div class="hero-summary">
          <p>Each play includes a concrete workflow, a vetted starter stack, the number to measure, and the moment a person should stay in control.</p>
          <a href="#automations">Explore all 15 <i class="fa fa-arrow-down" aria-hidden="true"></i></a>
        </div>
      </div>
    </header>

    <section class="evidence-section" aria-labelledby="evidence-title">
      <div class="guide-shell">
        <div class="section-heading section-heading--split">
          <div>
            <p class="eyebrow">Why these workflows</p>
            <h2 id="evidence-title">Automate the handoffs around the work.</h2>
          </div>
          <p>The best first automation is rarely a fully autonomous agent. It is a frequent, measurable handoff with clear inputs, a known owner, and an easy fallback.</p>
        </div>
        <div class="evidence-grid">
          {evidence.map((stat) => (
            <a class="evidence-card" href={stat.href} target="_blank" rel="noreferrer">
              <strong>{stat.value}</strong>
              <p>{stat.label}</p>
              <span>{stat.source} <i class="fa fa-external-link" aria-hidden="true"></i></span>
            </a>
          ))}
        </div>
        <aside class="use-note">
          <i class="fa fa-crosshairs" aria-hidden="true"></i>
          <div>
            <strong>Start with one outcome.</strong>
            <p>Choose a workflow with enough volume to matter. Capture a two-week baseline, automate the smallest end-to-end slice, and compare time, quality, and business results—not the number of AI tasks run.</p>
          </div>
        </aside>
      </div>
    </section>

    <nav class="category-nav" aria-label="Automation categories">
      <div class="guide-shell">
        <span>Jump to</span>
        {automationCategories.map((category) => (
          <a href={`#${category.toLowerCase()}`}>{category}</a>
        ))}
      </div>
    </nav>

    <div id="automations" class="automations">
      {automationCategories.map((category) => {
        const items = aiAutomations.filter((automation) => automation.category === category);
        return (
          <section id={category.toLowerCase()} class="automation-section" aria-labelledby={`${category.toLowerCase()}-title`}>
            <div class="guide-shell">
              <div class="category-heading">
                <p>{category}</p>
                <div>
                  <h2 id={`${category.toLowerCase()}-title`}>{categoryLabels[category]}</h2>
                  <span>{categoryIntros[category]}</span>
                </div>
                <b>{String(items.length).padStart(2, '0')} plays</b>
              </div>

              <div class="automation-list">
                {items.map((automation) => (
                  <article class="automation-card">
                    <div class="automation-card__number">{automation.number}</div>
                    <div class="automation-card__main">
                      <p class="automation-card__category">{automation.category} automation</p>
                      <h3>{automation.title}</h3>
                      <p class="automation-card__description">{automation.description}</p>

                      <div class="workflow-block">
                        <h4>How it works</h4>
                        <ol>
                          {automation.workflow.map((step) => <li>{step}</li>)}
                        </ol>
                      </div>

                      <div class="tool-block">
                        <h4>Practical starter stack</h4>
                        <div class="tool-list">
                          {automation.tools.map((tool) => (
                            <a href={tool.href} target="_blank" rel="noreferrer">
                              <b>{tool.name}</b><span>{tool.note}</span><i class="fa fa-external-link" aria-hidden="true"></i>
                            </a>
                          ))}
                        </div>
                      </div>
                    </div>

                    <aside class="automation-card__aside">
                      <div>
                        <p><i class="fa fa-line-chart" aria-hidden="true"></i> Measure</p>
                        <span>{automation.metric}</span>
                      </div>
                      <div>
                        <p><i class="fa fa-shield" aria-hidden="true"></i> Guardrail</p>
                        <span>{automation.guardrail}</span>
                      </div>
                      <a class="resource-link" href={automation.resource.href} target="_blank" rel="noreferrer">
                        {automation.resource.label} <i class="fa fa-arrow-right" aria-hidden="true"></i>
                      </a>
                    </aside>
                  </article>
                ))}
              </div>
            </div>
          </section>
        );
      })}
    </div>

    <section class="launch-section" aria-labelledby="launch-title">
      <div class="guide-shell">
        <div class="section-heading section-heading--split">
          <div>
            <p class="eyebrow">A sensible rollout</p>
            <h2 id="launch-title">Prove value before adding autonomy.</h2>
          </div>
          <p>Move from assistant to autopilot only when the evidence says the system is accurate, useful, and recoverable.</p>
        </div>
        <ol class="launch-steps">
          <li><span>01</span><div><b>Baseline</b><p>Measure current volume, handling time, quality, and business outcome.</p></div></li>
          <li><span>02</span><div><b>Assist</b><p>Let AI prepare the work while a person reviews every output.</p></div></li>
          <li><span>03</span><div><b>Evaluate</b><p>Score accuracy on representative examples, including exceptions.</p></div></li>
          <li><span>04</span><div><b>Automate</b><p>Auto-complete only high-confidence, low-risk cases.</p></div></li>
          <li><span>05</span><div><b>Observe</b><p>Log outcomes, sample quality, and keep the manual fallback working.</p></div></li>
        </ol>
      </div>
    </section>

    <footer class="guide-footer">
      <div class="guide-shell">
        <div>
          <img src="/img/about/dev-rocket-white-on-black.svg" alt="DevRocket" />
          <p>AI software engineering · Workflow automation</p>
        </div>
        <div>
          <p>Want help choosing the first workflow?</p>
          <a href="/#contact">Talk with DevRocket <i class="fa fa-arrow-right" aria-hidden="true"></i></a>
        </div>
      </div>
    </footer>
  </main>

  <script>document.querySelector('[data-print]')?.addEventListener('click', () => window.print());</script>
</BaseLayout>

<style is:global>
  :root { color-scheme: dark; }
  html { scroll-padding-top: 78px; background: #05060a; }
  body { margin: 0; background: #05060a; color: #f5f6fb; font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
  .guide-shell { width: min(100% - 48px, 1120px); margin: 0 auto; }
  .guide-controls { position: sticky; top: 0; z-index: 30; display: flex; align-items: center; justify-content: flex-end; min-height: 58px; border-bottom: 1px solid #202437; padding: 10px max(24px, calc((100vw - 1120px) / 2)); background: rgba(5,6,10,.92); color: #a0a5b8; font-size: 11px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; backdrop-filter: blur(16px); }
  .guide-controls button { border: 1px solid #1df9f8; border-radius: 6px; padding: 9px 14px; background: #1df9f8; color: #05060a; font: inherit; cursor: pointer; }
  .guide-controls button:hover { border-color: #fff; background: #fff; }
  .automation-guide { overflow: clip; }
  .guide-hero { position: relative; min-height: 760px; overflow: hidden; border-bottom: 1px solid #202437; background: radial-gradient(circle at 80% 15%, rgba(29,249,248,.14), transparent 25%), linear-gradient(145deg, #05060a, #0d101a); }
  .guide-grid { position: absolute; inset: 0; opacity: .36; background-image: linear-gradient(rgba(255,255,255,.045) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.045) 1px, transparent 1px); background-size: 52px 52px; mask-image: linear-gradient(to bottom, #000, transparent 92%); }
  .hero-orbit { position: absolute; border: 1px solid rgba(29,249,248,.25); border-radius: 50%; }
  .hero-orbit--one { top: -410px; right: -150px; width: 800px; height: 800px; }
  .hero-orbit--two { right: 15%; bottom: -410px; width: 640px; height: 640px; border-color: rgba(25,196,189,.12); }
  .guide-hero__inner { position: relative; z-index: 2; padding-top: 48px; padding-bottom: 90px; }
  .guide-brand { display: flex; align-items: center; justify-content: space-between; padding-bottom: 72px; }
  .guide-brand img { width: 168px; }
  .guide-brand span { color: #19c4bd; font-size: 10px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
  .guide-kicker { display: flex; align-items: center; gap: 10px; color: #a0a5b8; font-size: 11px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
  .guide-kicker span { width: 9px; height: 9px; border: 1px solid #1df9f8; }
  .guide-hero h1 { max-width: 1040px; margin: 20px 0 0; font-size: clamp(52px, 7.2vw, 94px); font-weight: 850; letter-spacing: -.068em; line-height: .9; }
  .guide-hero h1 em { color: #1df9f8; font-style: normal; }
  .guide-subtitle { margin-top: 34px; color: #f5f6fb; font-size: clamp(21px, 2.5vw, 31px); font-weight: 650; letter-spacing: -.025em; }
  .hero-summary { display: grid; grid-template-columns: minmax(0, 650px) auto; align-items: end; justify-content: space-between; gap: 50px; margin-top: 34px; }
  .hero-summary p { color: #a0a5b8; font-size: 17px; }
  .hero-summary a { display: inline-flex; align-items: center; gap: 11px; border-bottom: 1px solid #1df9f8; padding: 0 0 7px; color: #1df9f8; font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .evidence-section, .launch-section { padding: 112px 0; }
  .section-heading--split { display: grid; grid-template-columns: 1.15fr .65fr; align-items: end; gap: 90px; }
  .eyebrow { color: #19c4bd; font-size: 10px; font-weight: 850; letter-spacing: .16em; text-transform: uppercase; }
  .section-heading h2 { max-width: 680px; margin-top: 10px; font-size: clamp(40px, 5vw, 66px); letter-spacing: -.055em; line-height: .98; }
  .section-heading > p { color: #a0a5b8; font-size: 16px; }
  .evidence-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 54px; }
  .evidence-card { display: flex; min-height: 245px; flex-direction: column; align-items: flex-start; border: 1px solid #202437; border-top: 2px solid #19c4bd; padding: 30px; background: #10121b; transition: transform .2s ease, border-color .2s ease; }
  .evidence-card:hover { border-color: #19c4bd; transform: translateY(-3px); }
  .evidence-card strong { color: #1df9f8; font-size: clamp(48px, 6vw, 72px); letter-spacing: -.06em; line-height: .9; }
  .evidence-card p { max-width: 240px; margin-top: 18px; color: #f5f6fb; font-size: 16px; font-weight: 700; line-height: 1.35; }
  .evidence-card span { margin-top: auto; padding-top: 24px; color: #a0a5b8; font-size: 10px; font-weight: 750; letter-spacing: .06em; text-transform: uppercase; }
  .evidence-card i { margin-left: 5px; color: #19c4bd; }
  .use-note { display: grid; grid-template-columns: auto 1fr; gap: 20px; margin-top: 18px; border: 1px solid #1f6f73; padding: 26px 30px; background: rgba(29,249,248,.06); }
  .use-note > i { color: #1df9f8; font-size: 23px; }
  .use-note strong { font-size: 15px; }
  .use-note p { margin-top: 3px; color: #a0a5b8; font-size: 14px; }
  .category-nav { position: sticky; top: 58px; z-index: 20; border-block: 1px solid #202437; background: rgba(9,10,16,.95); backdrop-filter: blur(14px); }
  .category-nav .guide-shell { display: flex; align-items: center; gap: 8px; overflow-x: auto; padding-block: 13px; scrollbar-width: none; }
  .category-nav span { margin-right: 10px; color: #6d7488; font-size: 9px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .category-nav a { flex: 0 0 auto; border: 1px solid #202437; border-radius: 999px; padding: 7px 13px; color: #c6cad8; font-size: 10px; font-weight: 800; letter-spacing: .04em; }
  .category-nav a:hover { border-color: #19c4bd; color: #1df9f8; }
  .automation-section { scroll-margin-top: 118px; padding: 104px 0; border-bottom: 1px solid #202437; }
  .automation-section:nth-child(even) { background: #090a10; }
  .category-heading { display: grid; grid-template-columns: 120px 1fr auto; align-items: end; gap: 40px; margin-bottom: 48px; }
  .category-heading > p, .category-heading > b { color: #19c4bd; font-size: 10px; font-weight: 850; letter-spacing: .14em; text-transform: uppercase; }
  .category-heading h2 { font-size: clamp(38px, 5vw, 60px); letter-spacing: -.05em; line-height: .98; }
  .category-heading div > span { display: block; max-width: 660px; margin-top: 13px; color: #a0a5b8; }
  .category-heading > b { align-self: start; border: 1px solid #1f6f73; border-radius: 999px; padding: 7px 12px; }
  .automation-list { display: grid; gap: 22px; }
  .automation-card { display: grid; grid-template-columns: 72px minmax(0, 1fr) 300px; border: 1px solid #202437; background: #10121b; }
  .automation-card__number { border-right: 1px solid #202437; padding-top: 34px; color: #19c4bd; font-size: 12px; font-weight: 850; letter-spacing: .14em; text-align: center; }
  .automation-card__main { min-width: 0; padding: 34px 38px 38px; }
  .automation-card__category { color: #19c4bd; font-size: 9px; font-weight: 850; letter-spacing: .15em; text-transform: uppercase; }
  .automation-card h3 { max-width: 650px; margin-top: 8px; font-size: clamp(27px, 3.5vw, 40px); letter-spacing: -.045em; line-height: 1.02; }
  .automation-card__description { max-width: 700px; margin-top: 16px; color: #c6cad8; font-size: 15px; }
  .workflow-block, .tool-block { margin-top: 28px; }
  .workflow-block h4, .tool-block h4 { color: #6d7488; font-size: 9px; font-weight: 850; letter-spacing: .14em; text-transform: uppercase; }
  .workflow-block ol { display: grid; gap: 10px; margin-top: 13px; padding: 0; list-style: none; counter-reset: steps; }
  .workflow-block li { position: relative; padding-left: 26px; color: #a0a5b8; font-size: 13px; counter-increment: steps; }
  .workflow-block li::before { position: absolute; top: 1px; left: 0; content: counter(steps); color: #1df9f8; font-size: 9px; font-weight: 850; }
  .workflow-block li:not(:last-child)::after { position: absolute; top: 18px; bottom: -9px; left: 4px; width: 1px; content: ''; background: #1f6f73; }
  .tool-list { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .tool-list a { display: grid; grid-template-columns: auto auto auto; align-items: center; gap: 6px; border: 1px solid #2a3045; border-radius: 5px; padding: 8px 10px; background: #151825; font-size: 10px; }
  .tool-list a:hover { border-color: #19c4bd; }
  .tool-list b { color: #f5f6fb; }
  .tool-list span { color: #6d7488; }
  .tool-list i { color: #19c4bd; font-size: 8px; }
  .automation-card__aside { display: flex; flex-direction: column; border-left: 1px solid #202437; background: #0d0f17; }
  .automation-card__aside > div { border-bottom: 1px solid #202437; padding: 27px; }
  .automation-card__aside p { color: #19c4bd; font-size: 9px; font-weight: 850; letter-spacing: .12em; text-transform: uppercase; }
  .automation-card__aside p i { margin-right: 6px; }
  .automation-card__aside span { display: block; margin-top: 9px; color: #a0a5b8; font-size: 12px; line-height: 1.55; }
  .resource-link { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-top: auto; padding: 24px 27px; color: #1df9f8; font-size: 11px; font-weight: 800; line-height: 1.35; }
  .resource-link:hover { background: rgba(29,249,248,.06); }
  .launch-section { background: radial-gradient(circle at 12% 80%, rgba(29,249,248,.09), transparent 25%), #05060a; }
  .launch-steps { display: grid; grid-template-columns: repeat(5, 1fr); margin-top: 58px; padding: 0; list-style: none; }
  .launch-steps li { position: relative; min-height: 210px; border-block: 1px solid #202437; border-left: 1px solid #202437; padding: 25px 22px; background: #10121b; }
  .launch-steps li:last-child { border-right: 1px solid #202437; }
  .launch-steps li:not(:last-child)::after { position: absolute; top: 42px; right: -8px; z-index: 2; width: 15px; height: 15px; border-top: 1px solid #1df9f8; border-right: 1px solid #1df9f8; content: ''; background: #10121b; transform: rotate(45deg); }
  .launch-steps > li > span { color: #19c4bd; font-size: 10px; font-weight: 850; letter-spacing: .12em; }
  .launch-steps div { margin-top: 55px; }
  .launch-steps b { font-size: 18px; }
  .launch-steps p { margin-top: 7px; color: #a0a5b8; font-size: 12px; }
  .guide-footer { border-top: 1px solid #202437; padding: 70px 0; background: #090a10; }
  .guide-footer .guide-shell { display: flex; align-items: end; justify-content: space-between; gap: 50px; }
  .guide-footer img { width: 165px; }
  .guide-footer p { margin-top: 13px; color: #6d7488; font-size: 10px; font-weight: 750; letter-spacing: .1em; text-transform: uppercase; }
  .guide-footer > div > div:last-child { text-align: right; }
  .guide-footer a { display: inline-flex; align-items: center; gap: 10px; margin-top: 8px; color: #1df9f8; font-size: 14px; font-weight: 800; }
  @media (max-width: 900px) {
    .section-heading--split { grid-template-columns: 1fr; gap: 24px; }
    .evidence-grid { grid-template-columns: 1fr; }
    .evidence-card { min-height: 210px; }
    .category-heading { grid-template-columns: 88px 1fr; }
    .category-heading > b { display: none; }
    .automation-card { grid-template-columns: 56px 1fr; }
    .automation-card__aside { grid-column: 2; display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid #202437; border-left: 0; }
    .resource-link { grid-column: 1 / -1; }
    .launch-steps { grid-template-columns: 1fr; }
    .launch-steps li { min-height: 0; border-right: 1px solid #202437; border-bottom: 0; }
    .launch-steps li:last-child { border-bottom: 1px solid #202437; }
    .launch-steps li:not(:last-child)::after { top: auto; right: 50%; bottom: -8px; transform: rotate(135deg); }
    .launch-steps div { margin-top: 20px; }
  }
  @media (max-width: 620px) {
    .guide-shell { width: min(100% - 32px, 1120px); }
    .guide-controls { padding-inline: 16px; }
    .guide-controls button { padding-inline: 11px; font-size: 9px; }
    .guide-hero { min-height: 680px; }
    .guide-brand { padding-bottom: 60px; }
    .guide-brand img { width: 140px; }
    .guide-brand span { display: none; }
    .guide-hero h1 { font-size: clamp(45px, 14vw, 66px); }
    .hero-summary { grid-template-columns: 1fr; gap: 28px; }
    .hero-summary a { width: fit-content; }
    .evidence-section, .launch-section, .automation-section { padding-block: 76px; }
    .category-heading { grid-template-columns: 1fr; gap: 12px; }
    .category-heading > p { order: 1; }
    .category-heading > div { order: 2; }
    .automation-card { grid-template-columns: 1fr; }
    .automation-card__number { border-right: 0; padding: 22px 24px 0; text-align: left; }
    .automation-card__main { padding: 18px 24px 30px; }
    .automation-card__aside { grid-column: 1; grid-template-columns: 1fr; }
    .automation-card__aside > div { padding: 24px; }
    .resource-link { grid-column: 1; padding: 24px; }
    .tool-list { display: grid; }
    .tool-list a { grid-template-columns: auto 1fr auto; }
    .guide-footer .guide-shell { align-items: flex-start; flex-direction: column; }
    .guide-footer > div > div:last-child { text-align: left; }
  }
  @media print {
    @page { size: letter portrait; margin: .4in; }
    :root { color-scheme: light; }
    html, body, .automation-guide { background: #fff !important; color: #10121b !important; print-color-adjust: exact; -webkit-print-color-adjust: exact; }
    html, body { width: auto; min-width: 0; }
    body::before { display: none !important; }
    .guide-controls, .category-nav, .hero-orbit, .guide-grid, .hero-summary a { display: none !important; }
    .guide-shell { width: 100%; }
    .guide-hero { box-sizing: border-box; min-height: 0; break-after: auto; border: 1px solid #cbd1dc; background: #fff !important; color: #10121b !important; }
    .guide-hero__inner { padding: .22in .3in .26in; }
    .guide-brand { padding-bottom: .22in; }
    .guide-brand img { width: 145px; }
    .guide-brand img, .guide-footer img { filter: invert(1); }
