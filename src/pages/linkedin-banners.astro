---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="DevRocket LinkedIn Banner Concepts"
  description="Four screenshot-ready LinkedIn banner concepts for DevRocket."
>
  <main class="banner-gallery">
    <header class="gallery-intro">
      <div>
        <p class="gallery-eyebrow">DevRocket brand assets</p>
        <h1>LinkedIn banner concepts</h1>
        <p>Each canvas is exactly 1584 × 396 pixels. View at 100% and screenshot the banner you want to use.</p>
      </div>
      <div class="size-badge"><span></span> 1584 × 396</div>
    </header>

    <section class="concept" aria-labelledby="concept-one-title">
      <div class="concept-meta">
        <div><span>01</span><h2 id="concept-one-title">Expertise first</h2></div>
        <p>Clear positioning with a quiet technical system behind it.</p>
      </div>

      <div class="banner banner--expertise" id="banner-1">
        <div class="grid-texture"></div>
        <div class="orbit orbit--expertise"></div>
        <div class="profile-safe-zone" aria-hidden="true"></div>

        <div class="expertise-copy">
          <p class="banner-kicker"><i></i> Founder-led AI development</p>
          <h3>AI software that<br /><em>moves real work.</em></h3>
          <p class="banner-subtitle">From workflow design to production deployment.</p>
          <ul class="pill-list" aria-label="Areas of expertise">
            <li>Workflow automation</li>
            <li>Document AI</li>
            <li>RAG &amp; agents</li>
          </ul>
        </div>

        <p class="banner-signoff">devrocket.io <span>→</span></p>
      </div>
    </section>

    <section class="concept" aria-labelledby="concept-two-title">
      <div class="concept-meta">
        <div><span>02</span><h2 id="concept-two-title">Proof in the numbers</h2></div>
        <p>Outcome-led positioning for buyers who want measurable impact.</p>
      </div>

      <div class="banner banner--results" id="banner-2">
        <div class="results-sweep"></div>
        <div class="profile-safe-zone" aria-hidden="true"></div>

        <div class="results-heading">
          <p class="banner-kicker"><i></i> Production systems. Real outcomes.</p>
          <h3>Turn high-friction work into<br /><em>measurable momentum.</em></h3>
        </div>

        <div class="results-stats" aria-label="Selected client outcomes">
          <article>
            <strong>85%</strong>
            <span>time savings</span>
          </article>
          <article>
            <strong>$500K+</strong>
            <span>annual efficiency gains</span>
          </article>
          <article>
            <strong>90%</strong>
            <span>API performance improvement</span>
          </article>
        </div>

        <p class="banner-signoff">AI engineering · workflow automation · production delivery</p>
      </div>
    </section>

    <section class="concept" aria-labelledby="concept-three-title">
      <div class="concept-meta">
        <div><span>03</span><h2 id="concept-three-title">The senior builder</h2></div>
        <p>Personal, direct, and designed around founder-led credibility.</p>
      </div>

      <div class="banner banner--builder" id="banner-3">
        <div class="builder-lines"></div>
        <div class="profile-safe-zone" aria-hidden="true"></div>

        <div class="builder-copy">
          <p class="banner-kicker"><i></i> Work directly with the builder</p>
          <h3>Turn AI ideas into<br /><em>working software.</em></h3>
          <p>Architecture, implementation, deployment, and handoff—owned by one senior engineer.</p>
        </div>

        <div class="builder-proof">
          <p>Production experience across</p>
          <strong>LLMs · RAG · React · Node · Python · AWS · GCP</strong>
          <span>AI Software Engineering</span>
        </div>
      </div>
    </section>

    <section class="concept" aria-labelledby="concept-four-title">
      <div class="concept-meta">
        <div><span>04</span><h2 id="concept-four-title">The complete story</h2></div>
        <p>Positioning, production credibility, and delivery scope in one banner.</p>
      </div>

      <div class="banner banner--combined" id="banner-4">
        <div class="combined-grid"></div>
        <div class="combined-orbit"></div>
        <div class="profile-safe-zone" aria-hidden="true"></div>

<div class="expertise-copy">
          <h3>AI software that<br /><em>moves real work.</em></h3>
          <p class="banner-subtitle">From workflow design to production deployment.</p>
          
        </div>


        <div class="combined-proof">
          <p>Production experience across</p>
          <strong>Agents · LLMs · RAG · LangChain <br> React · Node · Python · AWS · GCP</strong>
          <span>AI Software Engineering</span>
        </div>

        <p class="banner-signoff">Workflow automation · Document AI · RAG &amp; agents · devrocket.io <span>→</span></p>
      </div>
    </section>

    <aside class="capture-note">
      <strong>For a clean export</strong>
      <p>Set browser zoom to 100%, capture only the banner canvas, and save as PNG. LinkedIn recommends a 1584 × 396 image.</p>
    </aside>
  </main>
</BaseLayout>

<style is:global>
  :root {
    color-scheme: dark;
    --canvas-w: 1584px;
    --canvas-h: 396px;
    --ink: #05060a;
    --panel: #10121b;
    --line: #202437;
    --text: #f5f6fb;
    --muted: #a0a5b8;
    --cyan: #1df9f8;
    --teal: #19c4bd;
    --deep: #147e6d;
    --gold: #f1c36d;
  }

  * { box-sizing: border-box; }

  html { background: #05060a; }

  body {
    margin: 0;
    background:
      radial-gradient(circle at 50% 0%, rgba(29, 249, 248, .08), transparent 30%),
      #05060a;
    color: var(--text);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .banner-gallery {
    width: min(100% - 40px, 1664px);
    margin: 0 auto;
    padding: 72px 0 100px;
  }

  .gallery-intro {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    max-width: var(--canvas-w);
    margin: 0 auto 72px;
    padding: 0 4px 32px;
    border-bottom: 1px solid var(--line);
  }

  .gallery-eyebrow {
    margin: 0 0 14px;
    color: var(--teal);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  .gallery-intro h1 {
    margin: 0;
    font-size: clamp(38px, 5vw, 72px);
    font-weight: 400;
    letter-spacing: -.055em;
    line-height: 1;
  }

  .gallery-intro > div > p:last-child {
    max-width: 680px;
    margin: 18px 0 0;
    color: var(--muted);
    font-size: 16px;
  }

  .size-badge {
    flex: none;
    display: flex;
    align-items: center;
    gap: 11px;
    border: 1px solid rgba(29, 249, 248, .35);
    border-radius: 999px;
    padding: 11px 17px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .1em;
  }

  .size-badge span {
    width: 8px;
    height: 8px;
    border: 1px solid var(--cyan);
  }

  .concept {
    margin-bottom: 76px;
    overflow-x: auto;
    padding-bottom: 12px;
  }

  .concept-meta {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 36px;
    width: var(--canvas-w);
    margin: 0 auto 18px;
  }

  .concept-meta > div {
    display: flex;
    align-items: baseline;
    gap: 15px;
  }

  .concept-meta span {
    color: var(--cyan);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .14em;
  }

  .concept-meta h2 {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
  }

  .concept-meta > p {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
  }

  .banner {
    position: relative;
    width: var(--canvas-w);
    height: var(--canvas-h);
    margin: 0 auto;
    overflow: hidden;
    isolation: isolate;
    background: var(--ink);
    box-shadow: 0 26px 80px rgba(0, 0, 0, .45);
  }

  .banner::after {
    position: absolute;
    inset: 0;
    z-index: 20;
    pointer-events: none;
    content: "";
    border: 1px solid rgba(255, 255, 255, .06);
  }

  .profile-safe-zone {
    position: absolute;
    left: 0;
    bottom: 0;
    z-index: 2;
    width: 420px;
    height: 300px;
  }

  .banner-kicker {
    display: flex;
    align-items: center;
    gap: 11px;
    margin: 0 0 15px;
    color: var(--muted);
    font-size: 18px;
    font-weight: 800;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .banner-kicker i {
    width: 9px;
    height: 9px;
    border: 1px solid var(--cyan);
  }

  .banner h3 {
    margin: 0;
    color: var(--text);
    font-size: 68px;
    font-weight: 400;
    letter-spacing: -.05em;
    line-height: .98;
  }

  .banner h3 em {
    color: var(--cyan);
    font-style: normal;
  }

  .banner-signoff {
    position: absolute;
    right: 52px;
    bottom: 28px;
    z-index: 5;
    margin: 0;
    color: var(--muted);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .banner-signoff span { color: var(--cyan); }

  /* Concept 1 */
  .banner--expertise {
    background:
      radial-gradient(circle at 88% 14%, rgba(29, 249, 248, .12), transparent 28%),
      linear-gradient(120deg, #05060a, #090c14 68%, #08191b);
  }

  .grid-texture {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: .5;
    background:
      linear-gradient(90deg, rgba(255,255,255,.028) 1px, transparent 1px),
      linear-gradient(rgba(255,255,255,.022) 1px, transparent 1px);
    background-size: 72px 72px;
  }

  .orbit {
    position: absolute;
    z-index: 0;
    border: 1px solid rgba(29, 249, 248, .38);
    border-radius: 50%;
  }

  .orbit--expertise {
    top: -330px;
    right: -80px;
    width: 730px;
    height: 730px;
  }

  .banner--expertise::before {
    position: absolute;
    right: 320px;
    top: -140px;
    z-index: 0;
    width: 1px;
    height: 680px;
    content: "";
    background: linear-gradient(transparent, rgba(29,249,248,.55), transparent);
    transform: rotate(24deg);
  }

  .expertise-copy {
    position: absolute;
    top: 52px;
    left: 440px;
    z-index: 4;
  }

  .banner-subtitle {
    margin: 17px 0 20px;
    color: var(--muted);
    font-size: 22px;
  }

  .pill-list {
    display: flex;
    gap: 9px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pill-list li {
    border: 1px solid rgba(29,249,248,.28);
    border-radius: 999px;
    padding: 10px 16px;
    background: rgba(29,249,248,.055);
    color: #c6cad8;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  /* Concept 2 */
  .banner--results {
    background:
      linear-gradient(110deg, rgba(5,6,10,.98) 0 31%, rgba(5,6,10,.82) 48%, transparent 68%),
      linear-gradient(135deg, #0b1f23, #063a3b);
  }

  .results-sweep {
    position: absolute;
    right: -6%;
    bottom: -280px;
    z-index: 0;
    width: 1160px;
    height: 470px;
    border: 1px solid rgba(29,249,248,.42);
    border-radius: 50%;
    box-shadow:
      0 -34px 0 -33px rgba(25,196,189,.28),
      0 -68px 0 -67px rgba(25,196,189,.17),
      0 -102px 0 -101px rgba(25,196,189,.1);
  }

  .results-heading {
    position: absolute;
    top: 58px;
    left: 440px;
    z-index: 3;
  }

  .results-heading h3 { font-size: 54px; }

  .results-stats {
    position: absolute;
    top: 54px;
    right: 50px;
    z-index: 4;
    display: grid;
    grid-template-columns: 150px 200px 180px;
    gap: 12px;
  }

  .results-stats article {
    min-height: 218px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    border: 1px solid rgba(29,249,248,.18);
    border-top-color: rgba(29,249,248,.72);
    border-radius: 7px;
    padding: 22px 20px;
    background: linear-gradient(180deg, rgba(16,18,27,.58), rgba(5,6,10,.84));
    backdrop-filter: blur(4px);
  }

  .results-stats strong {
    color: var(--cyan);
    font-size: 52px;
    font-weight: 400;
    letter-spacing: -.05em;
  }

  .results-stats span {
    margin-top: 5px;
    color: #c6cad8;
    font-size: 16px;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: .05em;
    text-transform: uppercase;
  }

  /* Concept 3 */
  .banner--builder {
    background:
      radial-gradient(circle at 72% 20%, rgba(29,249,248,.11), transparent 22%),
      linear-gradient(115deg, #05060a 0 58%, #0b171c 100%);
  }

  .builder-lines {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: .45;
    background:
      linear-gradient(165deg, transparent 0 67%, rgba(29,249,248,.34) 67.08%, transparent 67.16%),
      linear-gradient(194deg, transparent 0 74%, rgba(25,196,189,.24) 74.08%, transparent 74.16%);
  }

  .banner--builder::before {
    position: absolute;
    top: -260px;
    right: 420px;
    width: 630px;
    height: 630px;
    content: "";
    border: 1px solid rgba(29,249,248,.28);
    border-radius: 50%;
  }

  .builder-copy {
    position: absolute;
    top: 55px;
    left: 440px;
    z-index: 4;
    width: 560px;
  }

  .builder-copy > p:last-child {
    max-width: 470px;
    margin: 18px 0 0;
    color: var(--muted);
    font-size: 21px;
    line-height: 1.45;
  }

  .builder-proof {
    position: absolute;
    top: 58px;
    right: 50px;
    z-index: 4;
    width: 520px;
    border-left: 3px solid var(--cyan);
    padding: 30px 0 30px 30px;
    background: linear-gradient(90deg, rgba(29,249,248,.055), transparent);
  }

  .builder-proof p {
    margin: 0 0 9px;
    color: var(--muted);
    font-size: 17px;
    font-weight: 800;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  .builder-proof strong {
    display: block;
    color: var(--text);
    font-size: 27px;
    line-height: 1.45;
  }

  .builder-proof span {
    display: block;
    margin-top: 22px;
    color: var(--gold);
    font-size: 17px;
    font-weight: 700;
  }

  /* Concept 4 */
  .banner--combined {
    background:
      radial-gradient(circle at 74% 14%, rgba(29,249,248,.12), transparent 24%),
      linear-gradient(118deg, #05060a 0 55%, #08191b 100%);
  }

  .combined-grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: .42;
    background:
      linear-gradient(90deg, rgba(255,255,255,.026) 1px, transparent 1px),
      linear-gradient(rgba(255,255,255,.02) 1px, transparent 1px);
    background-size: 72px 72px;
  }

  .combined-orbit {
    position: absolute;
    top: -355px;
    right: 300px;
    width: 720px;
    height: 720px;
    border: 1px solid rgba(29,249,248,.3);
    border-radius: 50%;
  }

  .banner--combined::before {
    position: absolute;
    right: 470px;
    top: -180px;
    width: 1px;
    height: 760px;
    content: "";
    background: linear-gradient(transparent, rgba(29,249,248,.55), transparent);
    transform: rotate(25deg);
  }

  .combined-copy {
    position: absolute;
    top: 52px;
    left: 440px;
    z-index: 4;
  }

  .combined-copy h3 {
    font-size: 72px;
  }

  .combined-proof {
    position: absolute;
    top: 54px;
    right: 50px;
    z-index: 4;
    width: 560px;
    border: 1px solid rgba(29,249,248,.16);
    border-left: 3px solid var(--cyan);
    border-radius: 0 7px 7px 0;
    padding: 30px 32px;
    background: linear-gradient(100deg, rgba(29,249,248,.07), rgba(16,18,27,.72));
    backdrop-filter: blur(4px);
  }

  .combined-proof p {
    margin: 0 0 10px;
    color: var(--muted);
    font-size: 17px;
    font-weight: 800;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .combined-proof strong {
    display: block;
    color: var(--text);
    font-size: 27px;
    line-height: 1.45;
  }

  .combined-proof span {
    display: block;
    margin-top: 20px;
    color: var(--gold);
    font-size: 17px;
    font-weight: 700;
  }

  .combined-delivery {
    position: absolute;
    right: 50px;
    bottom: 25px;
    z-index: 4;
    margin: 0;
    color: var(--muted);
    font-size: 17px;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .capture-note {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 30px;
    max-width: var(--canvas-w);
    margin: 10px auto 0;
    border-left: 3px solid var(--gold);
    padding: 22px 26px;
    background: #10121b;
  }

  .capture-note strong {
    color: var(--gold);
    font-size: 12px;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .capture-note p {
    margin: 0;
    color: var(--muted);
    font-size: 13px;
  }

  @media (max-width: 900px) {
    .banner-gallery { width: 100%; padding-top: 40px; }
    .gallery-intro { width: calc(100% - 32px); margin-bottom: 52px; }
    .gallery-intro, .concept-meta { align-items: flex-start; flex-direction: column; }
    .concept-meta { margin-left: 16px; }
    .concept { padding-left: 16px; }
    .capture-note { width: calc(100% - 32px); grid-template-columns: 1fr; }
  }

  @media print {
    @page { size: 1584px 396px; margin: 0; }
    html, body { background: #fff; print-color-adjust: exact; -webkit-print-color-adjust: exact; }
    .gallery-intro, .concept-meta, .capture-note { display: none; }
    .banner-gallery, .concept { width: 1584px; margin: 0; padding: 0; overflow: visible; }
    .concept { break-after: page; }
    .concept:last-of-type { break-after: auto; }
    .banner { margin: 0; box-shadow: none; }
  }
</style>
